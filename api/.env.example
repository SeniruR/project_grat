# Copy to .env and fill in your local Postgres credentials from pgAdmin 4.
# Create an empty database named project_grat first.

DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/project_grat?schema=public"

PORT=3001
HOST=0.0.0.0
JWT_SECRET="dev-only-change-me-before-azure"
CORS_ORIGIN="http://localhost:5173,http://localhost:5174"
PUBLIC_API_URL="http://localhost:3001"

# Swap later without rewriting routes:
# AUTH_MODE=azure | DIRECTORY_MODE=graph | MAIL_MODE=graph|smtp
AUTH_MODE=dev
DIRECTORY_MODE=mock
MAIL_MODE=mock

# Gmail SMTP (MAIL_MODE=smtp) — use a Google App Password, not your login password:
# https://myaccount.google.com/apppasswords
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=you@gmail.com
# SMTP_PASS=your-16-char-app-password
# SMTP_FROM=you@gmail.com
# SMTP_FROM_NAME=Gratitude cards

# Azure AD work-account sign-in, company directory, and send-as-user.
# Leave AUTH_MODE=dev until these three values exist. Then set all of:
#   AUTH_MODE=azure
#   DIRECTORY_MODE=graph
#   MAIL_MODE=graph
# In the Azure portal the app registration lives under Microsoft Entra ID.
# Delegated Graph permissions (admin consent): User.Read, User.ReadBasic.All, Mail.Send.
# Redirect URI must match AZURE_REDIRECT_URI exactly (platform: Web).
# AZURE_TENANT_ID=
# AZURE_CLIENT_ID=
# AZURE_CLIENT_SECRET=
# AZURE_REDIRECT_URI=http://localhost:3001/auth/azure/callback
# AZURE_WEB_ORIGIN=http://localhost:5173
# Comma-separated work emails that should be ADMIN after they sign in:
# AZURE_ADMIN_EMAILS=you@yourcompany.com
# Optional app-only draft mailbox if MAIL_MODE=graph without Azure sign-in:
# GRAPH_MAILBOX_UPN=gratitude-sender@yourtenant.com
